<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_MapleBooking" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="1921008" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:collaboration id="Collaboration_MapleBooking">
    <bpmn:documentation>Teaching case: the proposed (future-state) room-booking process for the fictional Maple Campus pilot. Element documentation traces each step to the solution requirements (SOL), stakeholder requirements (SR) and risks (R) on the ITBA Exemplars page.</bpmn:documentation>
    <bpmn:participant id="Participant_Booking" name="Maple Campus room booking (pilot)" processRef="Process_RoomBooking" />
    <bpmn:participant id="Participant_Email" name="Email delivery service" />
    <bpmn:participant id="Participant_RoomCloud" name="RoomCloud room calendar" />
    <bpmn:messageFlow id="Message_AvailabilityQuery" name="Availability query" sourceRef="Task_CheckAvailability" targetRef="Participant_RoomCloud" />
    <bpmn:messageFlow id="Message_AvailabilityResult" name="Availability result" sourceRef="Participant_RoomCloud" targetRef="Task_CheckAvailability" />
    <bpmn:messageFlow id="Message_Reserve" name="Reserve room" sourceRef="Task_ReserveRoom" targetRef="Participant_RoomCloud" />
    <bpmn:messageFlow id="Message_ReserveResult" name="Booking result" sourceRef="Participant_RoomCloud" targetRef="Task_ReserveRoom" />
    <bpmn:messageFlow id="Message_Notification" name="Notification instruction" sourceRef="Activity_01o0omd" targetRef="Participant_Email" />
    <bpmn:textAnnotation id="Annotation_Scope">
      <bpmn:text>Changes and cancellations (SR05, SOL04) follow their own request path and are not shown here.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Process_RoomBooking" name="Room booking request" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Booking">
      <bpmn:lane id="Lane_Organizer" name="Club organizer">
        <bpmn:flowNodeRef>StartEvent_RoomNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CorrectDetails</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Service" name="Booking service">
        <bpmn:flowNodeRef>Task_ValidateRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DetailsComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RetryMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HoldPending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_Retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReserveRoom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Reserved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyRequester</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_CalendarUnavailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RequesterNotified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_01o0omd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Facilities" name="Facilities approver">
        <bpmn:flowNodeRef>Task_ReviewRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_DecisionOverdue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_DeputyAlerted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_RoomNeeded" name="Room needed for a club event">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SubmitRequest" name="Submit room request">
      <bpmn:documentation>SR01, SOL01: club, event date, start and end times, capacity, equipment and access needs. Status becomes Submitted.</bpmn:documentation>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ValidateRequest" name="Validate request details">
      <bpmn:documentation>SOL01: missing required fields, or an end time before the start, are flagged so the organizer can correct them.</bpmn:documentation>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_DetailsComplete" name="Details complete?">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CorrectDetails" name="Correct flagged fields">
      <bpmn:documentation>SOL01, SOL06: errors identify the field to correct and are announced to assistive technology.</bpmn:documentation>
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_RetryMerge">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CheckAvailability" name="Check room availability">
      <bpmn:documentation>Queries the RoomCloud calendar so the approver sees current availability.</bpmn:documentation>
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_CalendarUnavailable" name="Calendar unavailable" attachedToRef="Task_CheckAvailability">
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_CalendarUnavailable" errorRef="Error_CalendarUnavailable" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_HoldPending" name="Alert IT Services">
      <bpmn:documentation>R04 mitigation: make the failed check visible and keep the request pending until availability can be verified.</bpmn:documentation>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Timer_Retry" name="Retry after 15 minutes">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Retry">
        <bpmn:timeDuration>PT15M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_ReviewRequest" name="Record decision">
      <bpmn:documentation>SR03, SOL02: status becomes In review. The approver records approval or refusal with a reason.</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_DecisionOverdue" name="1 working day elapsed" cancelActivity="false" attachedToRef="Task_ReviewRequest">
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_DecisionOverdue">
        <bpmn:timeDuration>P1D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_Escalate" name="Escalate to deputy approver">
      <bpmn:documentation>SR09, BR01: a named deputy covers the approval queue so complete requests are decided within one working day.</bpmn:documentation>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Decision?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ReserveRoom" name="Reserve room">
      <bpmn:documentation>SR04, SOL03, R01 mitigation: availability is rechecked and the room reserved as one consistent operation, so two overlapping approvals cannot both be confirmed.</bpmn:documentation>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Reserved" name="Room reserved?">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_DecisionMerge">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_NotifyRequester" name="Update status">
      <bpmn:documentation>SR02, SOL02, SOL04: status becomes Confirmed or Declined; the requester sees the reason and receives a notification.</bpmn:documentation>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_RoomNeeded" targetRef="Task_SubmitRequest" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SubmitRequest" targetRef="Task_ValidateRequest" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ValidateRequest" targetRef="Gateway_DetailsComplete" />
    <bpmn:sequenceFlow id="Flow_04" name="No" sourceRef="Gateway_DetailsComplete" targetRef="Task_CorrectDetails" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_CorrectDetails" targetRef="Task_ValidateRequest" />
    <bpmn:sequenceFlow id="Flow_06" name="Yes" sourceRef="Gateway_DetailsComplete" targetRef="Gateway_RetryMerge" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gateway_RetryMerge" targetRef="Task_CheckAvailability" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Boundary_CalendarUnavailable" targetRef="Task_HoldPending" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_HoldPending" targetRef="Timer_Retry" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Timer_Retry" targetRef="Gateway_RetryMerge" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_CheckAvailability" targetRef="Task_ReviewRequest" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ReviewRequest" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_13" name="Approve" sourceRef="Gateway_Decision" targetRef="Task_ReserveRoom" />
    <bpmn:sequenceFlow id="Flow_14" name="Decline with reason" sourceRef="Gateway_Decision" targetRef="Gateway_DecisionMerge" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_ReserveRoom" targetRef="Gateway_Reserved" />
    <bpmn:sequenceFlow id="Flow_16" name="Yes" sourceRef="Gateway_Reserved" targetRef="Gateway_DecisionMerge" />
    <bpmn:sequenceFlow id="Flow_17" name="No: conflict" sourceRef="Gateway_Reserved" targetRef="Task_ReviewRequest" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Gateway_DecisionMerge" targetRef="Task_NotifyRequester" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_NotifyRequester" targetRef="Activity_01o0omd" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Boundary_DecisionOverdue" targetRef="Task_Escalate" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_Escalate" targetRef="EndEvent_DeputyAlerted" />
    <bpmn:endEvent id="EndEvent_RequesterNotified" name="Requester notified of decision">
      <bpmn:incoming>Flow_10z4fce</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_DeputyAlerted" name="Deputy approver alerted">
      <bpmn:incoming>Flow_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_10z4fce" sourceRef="Activity_01o0omd" targetRef="EndEvent_RequesterNotified" />
    <bpmn:serviceTask id="Activity_01o0omd" name="Notify requester">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_10z4fce</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
  <bpmn:error id="Error_CalendarUnavailable" name="Calendar unavailable" errorCode="CALENDAR_UNAVAILABLE" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_MapleBooking">
