---
import { Image } from 'astro:assets';
import programImage from '../assets/it-business-analysis.jpg';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="shell hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Discover IT Business Analysis</p>
      <h1 id="hero-title">Good questions.<br /><span>Meaningful change.</span></h1>
      <p class="hero-intro">Connect people, business needs and technology. Explore how business analysis helps turn a better understanding of a problem into a thoughtful next step.</p>
      <div class="button-row">
        <a class="button" href="/business-analysis/">See business analysis in action <span aria-hidden="true">→</span></a>
        <a class="text-link" href="https://nait.ca/itbusiness">Explore the diploma <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <figure class="hero-photo">
      <Image src={programImage} alt="A person maps ideas on a glass wall covered in sticky notes while holding a laptop." widths={[560, 900, 1200]} sizes="(max-width: 800px) 100vw, 50vw" width={1200} loading="eager" fetchpriority="high" format="webp" />
      <figcaption><span class="photo-label">IT BUSINESS ANALYSIS</span><span>Start with people. Understand the need.</span></figcaption>
    </figure>
  </div>
</section>
