---
interface Props { source: string; caption: string; }
const { source, caption } = Astro.props;
---
<figure class="diagram-figure">
  <div class="diagram-scroll" tabindex="0" role="region" aria-label={caption}>
    <pre class="mermaid">{source}</pre>
  </div>
  <figcaption>{caption}</figcaption>
  <details class="diagram-source">
    <summary>View editable Mermaid source</summary>
    <pre><code>{source}</code></pre>
  </details>
</figure>
<script>
  import mermaid from 'mermaid';
  mermaid.initialize({
    startOnLoad: false,
    securityLevel: 'strict',
    theme: 'base',
    themeVariables: {
      fontFamily: 'Source Sans 3, sans-serif',
      fontSize: '18px',
      primaryColor: '#edf4fb',
      primaryTextColor: '#002d74',
      primaryBorderColor: '#005cb9',
      lineColor: '#005cb9',
      secondaryColor: '#e1f4fc',
      tertiaryColor: '#ffffff',
    },
    flowchart: { htmlLabels: false, curve: 'linear', useMaxWidth: false, nodeSpacing: 30, rankSpacing: 55 },
  });
  await document.fonts.ready;
  await mermaid.run({ querySelector: '.mermaid' });
</script>
