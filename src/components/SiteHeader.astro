---
const { pathname } = Astro.url;
---
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="shell masthead">
    <a class="brand" href="/" aria-label="NAIT IT Business Analysis home">
      <picture>
        <source media="(max-width: 800px)" srcset="/brand/nait-shield.svg" />
        <img src="/brand/nait-logo-white.svg" width="200" height="50" alt="NAIT" />
      </picture>
      <span>IT Business<br />Analysis</span>
    </a>
    <a class="official-link" href="https://nait.ca/itbusiness">Official program information <span aria-hidden="true">↗</span></a>
  </div>
  <nav class="primary-nav" aria-label="Main navigation">
    <div class="shell nav-inner">
      <a href="/" aria-current={pathname === '/' ? 'page' : undefined}>Discover ITBA</a>
      <a href="/our-identity/" aria-current={pathname === '/our-identity/' ? 'page' : undefined}>Our identity</a>
      <a href="/your-success/" aria-current={pathname === '/your-success/' ? 'page' : undefined}>Your success</a>
      <a href="/business-analysis/" aria-current={pathname === '/business-analysis/' ? 'page' : undefined}>BA in practice</a>
      <a href="/exemplars/" aria-current={pathname === '/exemplars/' ? 'page' : undefined}>Exemplars</a>
      <a href="/faq/" aria-current={pathname === '/faq/' ? 'page' : undefined}>FAQ</a>
    </div>
  </nav>
</header>
